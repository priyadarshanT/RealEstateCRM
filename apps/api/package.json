{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "jest --runInBand",
    "api:check": "jest --runInBand test/contract.spec.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-ssm": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "csv-parse": "^5",
    "drizzle-orm": "^0.44",
    "exceljs": "^4",
    "jose": "^5",
    "pg": "^8",
    "pg-boss": "^10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29",
    "@types/node": "^22.10.0",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "jest": "^29",
    "supertest": "^7",
    "ts-jest": "^29",
    "tsx": "^4",
    "typescript": "^5.6.0",
    "yaml": "^2"
  },
  "jest": {
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/test/tsconfig.json"
        }
      ]
    },
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
