# Copy to apps/web/.env.local for local development. Never commit .env.local.

# Where the NestJS API runs. The browser never calls it directly: /api/v1/* is forwarded by the web server.
API_URL=http://localhost:4000

# Login: "dev" locally (same DEV_AUTH_SECRET as apps/api/.env), "cognito" in AWS.
AUTH_MODE=dev
DEV_AUTH_SECRET=CHANGE_ME_TO_THE_SAME_VALUE_AS_THE_API

# AWS only (AUTH_MODE=cognito; Terraform writes these to SSM under /crm/<env>/web/*). Not needed locally.
# WEB_APP_URL=https://crm.example.ae                      public address; Cognito returns to /auth/callback
# COGNITO_DOMAIN=https://<prefix>.auth.me-central-1.amazoncognito.com
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# PLATFORM_COGNITO_DOMAIN=                                owner console pool (/auth/platform-callback)
# PLATFORM_COGNITO_CLIENT_ID=
# PLATFORM_COGNITO_CLIENT_SECRET=
# SESSION_SECRET=                                         encrypts the refresh token cookie (32+ random characters)
