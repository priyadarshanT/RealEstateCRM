# Copy to apps/api/.env for local development. Never commit .env.
# Staging and production values come from AWS SSM Parameter Store.

NODE_ENV=development
PORT=4000

# The API connects as crm_app so row-level security applies (never as postgres).
# Locally: ALTER ROLE crm_app PASSWORD '...'; then put the same password here.
DATABASE_URL=postgres://crm_app:CHANGE_ME@localhost:5432/crm_dev
DATABASE_POOL_MAX=10

# Worker (APP_MODE=worker): crm_worker, only for cross-tenant scans and the job queue.
WORKER_DATABASE_URL=postgres://crm_worker:CHANGE_ME@localhost:5432/crm_dev

# Owner console and Stripe webhooks: crm_platform (security.sql).
PLATFORM_DATABASE_URL=postgres://crm_platform:CHANGE_ME@localhost:5432/crm_dev

# Owner connection used only by `pnpm db:migrate` and test clean-up. Encode @ in passwords as %40.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/crm_dev

# Login: "cognito" in AWS, "dev" locally (tokens from `pnpm --filter @crm/api dev:token <tenantId> <email>`).
AUTH_MODE=dev
# Any random string of 32+ characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEV_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_CHARS
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Files: S3 bucket in AWS; locally MinIO (docker/docker-compose.yml) with S3_ENDPOINT=http://localhost:9000
S3_BUCKET=
S3_REGION=me-central-1
S3_ENDPOINT=

# Integration tokens: "ssm" in staging/production, "memory" locally (lost on restart)
SECRETS_MODE=memory
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
OAUTH_STATE_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_CHARS

# Meta lead ads (Meta for Developers app)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Stripe (test mode locally and in staging). Without keys the API runs; billing calls report Stripe is not configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Bot check on public sign-up (Cloudflare Turnstile). Required in production.
TURNSTILE_SECRET=

# Email: "log" writes emails to the server log locally; "ses" sends with Amazon SES.
MAIL_MODE=log
MAIL_FROM=Dubai Real Estate CRM <no-reply@crm.example.ae>

# WhatsApp and lead email: "simulate" accepts and logs messages locally; "live" sends through the
# company's connected WhatsApp Business number (Meta) and SES. Production must be "live".
MESSAGING_MODE=simulate

# Google Meet / Teams links and calendar sync: "simulate" makes stand-in links locally; "live" uses each agent's
# connected Google or Microsoft account. Production must be "live".
CALENDAR_MODE=simulate

# Owner console login (separate Cognito pool) and the CRM pool used to invite a new company Admin
PLATFORM_COGNITO_ISSUER=
PLATFORM_COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=

# PDF maker (Gotenberg, docker/docker-compose.yml)
GOTENBERG_URL=http://localhost:3001
