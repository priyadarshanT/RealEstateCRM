# Copy to apps/api/.env for local development. Never commit .env.
# Staging and production values come from AWS SSM Parameter Store.

NODE_ENV=development
PORT=4000

# The API connects as crm_app so row-level security applies (never as postgres).
# Locally: ALTER ROLE crm_app PASSWORD '...'; then put the same password here.
DATABASE_URL=postgres://crm_app:CHANGE_ME@localhost:5432/crm_dev
DATABASE_POOL_MAX=10

# Owner connection used only by `pnpm db:migrate` and test clean-up. Encode @ in passwords as %40.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/crm_dev

# Login: "cognito" in AWS, "dev" locally (tokens from `pnpm --filter @crm/api dev:token <tenantId> <email>`).
AUTH_MODE=dev
# Any random string of 32+ characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEV_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_CHARS
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
